# ==============================================================================
# KidneyVision AI - Production Environment Template (Azure / Docker Stack)
# ==============================================================================

# Application Configuration
APP_NAME="KidneyVision AI"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:cK15Y1E4Y00FOGQd3H0Y5B40pZ1vB5h0+H1f1m9X+8M=
# Replace APP_URL and FRONTEND_URL with your Azure Public IP or Domain
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost

# Frontend Build Variable (Leave empty to use auto-resolving reverse-proxy)
VITE_API_URL=

# ------------------------------------------------------------------------------
# Database Option A: Built-in SQLite (Default, Zero-Configuration)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# ------------------------------------------------------------------------------
# Database Option B: Supabase PostgreSQL (Uncomment and fill to use)
# ------------------------------------------------------------------------------
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-eu-central-1.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-secure-password
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# AI Microservice Wiring
# ------------------------------------------------------------------------------
AI_FLASK_BASE_URL=http://ai-service:5000
AI_SERVICE_URL=http://ai-service:5000
AI_PREDICT_ENDPOINT=/predict
AI_HEALTH_ENDPOINT=/health
AI_TIMEOUT=60
AI_RETRY_TIMES=3
AI_RETRY_SLEEP=1000
AI_MOCK_ENABLED=false

# ------------------------------------------------------------------------------
# Storage & Sessions
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# Security & CORS
# ------------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SESSION_DOMAIN=

# ------------------------------------------------------------------------------
# Mail Settings (Optional)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@kidneyvision.com"
MAIL_FROM_NAME="${APP_NAME}"
