# ==============================================================================
# KidneyVision AI — Global Environment Configuration Example
# ==============================================================================

# Laravel Backend API Configuration
APP_NAME="KidneyVision AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Database Configuration (SQLite default; can be switched to MySQL / PostgreSQL)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kidney_vision
# DB_USERNAME=root
# DB_PASSWORD=

# Session & Authentication
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DRIVER=file

# AI Service Microservice Integration
AI_FLASK_BASE_URL=http://127.0.0.1:5000
AI_PREDICT_ENDPOINT=/predict
AI_HEALTH_ENDPOINT=/health
AI_TIMEOUT=30
AI_RETRY_TIMES=3
AI_RETRY_SLEEP=1000
AI_MOCK_ENABLED=false

# React Frontend Configuration
VITE_API_URL=http://localhost:8000/api
VITE_AI_SERVICE_URL=http://localhost:5000

# Flask AI Service Configuration
FLASK_ENV=development
MODEL_PATH=best_model.keras
